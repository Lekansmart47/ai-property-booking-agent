    {
      "parameters": {
        "jsCode": "// Lightweight, self-contained AFINN-based Sentiment Analyzer\nconst positiveWords = new Set(['help', 'expert', 'love', 'good', 'great', 'awesome', 'fix', 'recommend', 'need', 'looking', 'hire', 'setup', 'build', 'perfect', 'solved']);\nconst negativeWords = new Set(['broke', 'broken', 'hate', 'error', 'fail', 'failed', 'issue', 'bug', 'expensive', 'costly', 'overage', 'stuck', 'slow', 'worst', 'brutal', 'charge', 'wrong']);\n\nfor (const item of $input.all()) {\n  const text = (item.json.body?.text || \"\").toLowerCase();\n  const words = text.replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()]/g, \"\").split(/\\s+/);\n  \n  let score = 0;\n  for (const word of words) {\n    if (positiveWords.has(word)) score += 1;\n    if (negativeWords.has(word)) score -= 1.5; // Weight complaints higher for sales intent\n  }\n  \n  let classification = \"Neutral\";\n  if (score > 0) classification = \"Positive/Inquiry\";\n  if (score < 0) classification = \"Frustrated/Pain Point\";\n  \n  item.json.analysis = {\n    sentiment_score: score,\n    sentiment_label: classification\n  };\n}\n\nreturn $input.all();"
      },
